VISION_MODEL_PROVIDER=openai_compatible
VISION_MODEL_API_KEY=
VISION_MODEL_BASE_URL=
VISION_MODEL_NAME=

# Optional: persist /aliyun-app-chat-test operation artifacts to GitHub.
# Create a fine-grained token with Contents: Read and write for this repo.
GITHUB_OPERATION_TOKEN=
GITHUB_OPERATION_REPO=yangyanghu719-pixel/color-agent-plugins
GITHUB_OPERATION_BRANCH=composition-lab-data
GITHUB_OPERATION_BASE_DIR=backend_data_storage
# When GitHub sync succeeds, delete duplicate server-local operation artifacts to reduce disk usage.
GITHUB_OPERATION_DELETE_LOCAL_AFTER_SYNC=true
